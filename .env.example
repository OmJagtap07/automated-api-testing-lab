# .env.example
# Copy this file to .env and fill in the actual values.
# NEVER commit .env to version control.

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?appName=BeatHub

# Secret key used for signing JWT tokens (use a long, random string in production)
JWT_SECRET=

# JWT token expiry duration (e.g., 7d, 1h, 30m)
JWT_EXPIRES_IN=7d

# Port the server listens on
PORT=5000

# Current environment: development | staging | production
NODE_ENV=development
